# Copy to tools/plane_watcher.env and adjust for your machine.
# REPO_ROOT is exported by the wrapper scripts before this file is sourced.

# Vivado installation.
VIVADO_SETTINGS=/opt/vivado/2025.2/Vivado/settings64.sh

# Legacy vendor HDL checkout used only by retired Pluto/vendor build scripts.
VENDOR_HDL_ROOT=$HOME/Downloads/sdr/Fish-Wan-plutosdr-fw-7020-SDR

# Legacy build mode for tools/build-bitstream.sh.
BUILD_TARGET=stock-tap-build

# Legacy FPGA wrapper debug setting for tools/build-bitstream.sh.
DEEP_DEBUG=0

# Legacy implementation output directory used by tools/deploy-bitstream.sh.
IMPL_DIR=$REPO_ROOT/hdl/vivado/build/plane_watcher/plane_watcher.runs/impl_1

# Active firmware deployment defaults for tools/rebuild.sh.
TARGET_HOST=root@planewatcher.local
TARGET_IMAGE_DIR=/run/media/mmcblk0p1
SSHPASS_PASSWORD=planewatcher
