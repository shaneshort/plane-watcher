# Copy to tools/plane_watcher.env and adjust for your machine.
# REPO_ROOT is exported by the wrapper scripts before this file is sourced.

# Vivado installation.
VIVADO_SETTINGS=/opt/vivado/2025.2/Vivado/settings64.sh

# Vendor HDL checkout used by the hybrid build scripts.
VENDOR_HDL_ROOT=$HOME/Downloads/sdr/Fish-Wan-plutosdr-fw-7020-SDR

# Default build mode: stock-tap-build or vendor-build.
BUILD_TARGET=stock-tap-build

# Set to 1 to enable CONFIG.ENABLE_DEEP_DEBUG in the FPGA wrapper build.
DEEP_DEBUG=0

# Implementation output directory used for bitstream packaging/deploy.
IMPL_DIR=$REPO_ROOT/hdl/vivado/build/plane_watcher/plane_watcher.runs/impl_1

# Remote deployment defaults.
TARGET_HOST=root@pluto.local
TARGET_BIT_PATH=/boot/system.bit.bin
TARGET_BOOT_MOUNT=/boot
SSHPASS_PASSWORD=analog
